#include <Wire.h>

#define BM8563_ADDR 0x51

#define REG_CTRL1     0x00
#define REG_CTRL2     0x01
#define REG_MIN_ALM   0x09
#define REG_HOUR_ALM  0x0A
#define REG_DAY_ALM   0x0B
#define REG_WDAY_ALM  0x0C

#define ALARM_PIN 2 

int hourInput = -1;
int minuteInput = -1;
int dayInput = -1;

void setup() {
  Serial.begin(9600);
  Wire.begin();

  pinMode(LED_BUILTIN, OUTPUT);
  pinMode(ALARM_PIN, INPUT_PULLUP);

  writeRegister(REG_CTRL1, 0x00);
  writeRegister(REG_CTRL2, 0x00);

  Serial.println("Saat Dakika Gun seklinde giriniz (ornegin: 15 30 20)");
}

void loop() {
  if (Serial.available() > 0) {
    hourInput = Serial.parseInt();
    minuteInput = Serial.parseInt();
    dayInput = Serial.parseInt();

    if (hourInput >= 0 && minuteInput >= 0 && dayInput > 0) {
      setAlarm(minuteInput, hourInput, dayInput);

      uint8_t ctrl2 = readRegister(REG_CTRL2);
      ctrl2 |= (1 << 1);  
      writeRegister(REG_CTRL2, ctrl2);

      Serial.print("Alarm ayarlandi: ");
      Serial.print(dayInput);
      Serial.print(". gun ");
      Serial.print(hourInput);
      Serial.print(":");
      Serial.println(minuteInput);
    }
  }

  if (digitalRead(ALARM_PIN) == LOW) {
    Serial.println("ALARM TETIKLENDI");
    digitalWrite(LED_BUILTIN, HIGH);
    delay(5000);
    digitalWrite(LED_BUILTIN, LOW);

    uint8_t ctrl2 = readRegister(REG_CTRL2);
    ctrl2 &= ~(1 << 3);  
    writeRegister(REG_CTRL2, ctrl2);
  }
}

void setAlarm(int minute, int hour, int day) {
  uint8_t min_bcd = decToBcd(minute) & 0x7F; 
  uint8_t hour_bcd = decToBcd(hour) & 0x3F;
  uint8_t day_bcd = decToBcd(day) & 0x3F;

  writeRegister(REG_MIN_ALM, min_bcd);
  writeRegister(REG_HOUR_ALM, hour_bcd);
  writeRegister(REG_DAY_ALM, day_bcd);
  writeRegister(REG_WDAY_ALM, 0x80); 
}

void writeRegister(uint8_t reg, uint8_t value) {
  Wire.beginTransmission(BM8563_ADDR);
  Wire.write(reg);
  Wire.write(value);
  Wire.endTransmission();
}

uint8_t readRegister(uint8_t reg) {
  Wire.beginTransmission(BM8563_ADDR);
  Wire.write(reg);
  Wire.endTransmission();
  Wire.requestFrom(BM8563_ADDR, 1);
  return Wire.read();


}

uint8_t decToBcd(uint8_t val) {
  return ((val / 10 * 16) + (val % 10));
}

